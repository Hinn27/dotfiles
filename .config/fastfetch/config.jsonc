{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "source": "/home/hinne/.config/fastfetch/logo.txt",
    "type": "auto"
  },
  "display": {
    "separator": " │ "
  },
  "modules": [
    {
      "type": "custom",
      "format": "╭─────────────╮"
    },
    {
      "type": "os",
      "key": "│ {#35}🐧 OS      {#39}",
      "keyColor": "white"
    },
    {
      "type": "kernel",
      "key": "│ {#36}🧬 Kernel  {#39}",
      "keyColor": "white"
    },
    {
      "type": "shell",
      "key": "│ {#37}💲 Shell   {#39}",
      "keyColor": "white"
    },
    {
      "type": "terminal",
      "key": "│ {#34}>_ Terminal{#39}",
      "keyColor": "white"
    },
    {
      "type": "wm",
      "key": "│ {#35}🖵  WM      {#39}",
      "keyColor": "white"
    },
    {
      "type": "custom",
      "key": "│ {#34}🖳  CPU     {#39}",
      "format": "i5 11400H",
      "keyColor": "white"
    },
    {
      "type": "custom",
      "key": "│ {#35}🎮 GPU     {#39}",
      "format": "RTX 3050 4GB",
      "keyColor": "white"
    },
    {
      "type": "custom",
      "key": "│ {#35}🎮 GPU     {#39}",
      "format": "Intel UHD",
      "keyColor": "white"
    },
    {
      "type": "memory",
      "key": "│ {#34}🧠 Memory  {#39}",
      "keyColor": "white"
    },
    {
      "type": "uptime",
      "key": "│ {#32}⏳ Uptime  {#39}",
      "keyColor": "white"
    },
    {
      "type": "custom",
      "format": "╰─────────────╯"
    }
  ]
}
